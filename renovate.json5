{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'security:minimumReleaseAgeNpm',
    ':dependencyDashboard',
  ],
  timezone: 'Asia/Tokyo',
  rangeStrategy: 'bump',
  prConcurrentLimit: 20,
  prHourlyLimit: 10,
  reviewers: [
    'Soli0222',
  ],
  assignees: [
    'Soli0222',
  ],
  semanticCommits: 'enabled',
  prCreation: 'immediate',
  rebaseWhen: 'auto',
  dependencyDashboard: true,
  vulnerabilityAlerts: {
    enabled: true,
    labels: [
      'security',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^charts/.+/values\\.yaml$/',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\s+tag:\\s*["\'](?<currentValue>[^"\']+)["\']',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'docker',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/go\\.mod$/',
      ],
      matchStrings: [
        'go (?<currentValue>\\d+\\.\\d+\\.\\d+)\\n',
      ],
      depNameTemplate: 'golang',
      datasourceTemplate: 'golang-version',
    },
  ],
  // chart の image tag を上げたら同じ PR で chart version の patch を上げる。
  // これが無いと chart-guard の経路 B が成立しない。
  // experimental な機能なので renovate のバージョン更新時は挙動を確認する。
  bumpVersions: [
    {
      filePatterns: [
        '{{packageFileDir}}/Chart.yaml',
      ],
      matchStrings: [
        '(?:^|\\n)version:\\s*(?<version>[^\\s]+)',
      ],
      bumpType: 'patch',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'charts/**/values.yaml',
      ],
      commitMessageTopic: 'Chart image {{depName}}',
      // fix(chart) だと release-please がアプリのリリースとして拾ってしまい、
      // コードが1行も変わっていないのに依存イメージのタグを上げただけで
      // アプリのリリースが発生する。chart の変更は chart の publish だけで完結させる。
      semanticCommitType: 'chore',
      semanticCommitScope: 'chart',
      addLabels: [
        'chart',
      ],
      // 経路 B (image tag だけの変更 + chart version の patch bump)。
      // chart-guard が分類を強制するので automerge して良い。
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: false,
    },
    {
      matchManagers: [
        'custom.regex',
      ],
      matchFileNames: [
        'charts/**/values.yaml',
      ],
      matchUpdateTypes: [
        'major',
      ],
      automerge: false,
      addLabels: [
        'major-update',
      ],
    },
    {
      matchDepNames: [
        'golang',
      ],
      groupName: 'golang version',
      commitMessageTopic: 'Go version',
      automerge: true,
    },
    {
      matchManagers: [
        'github-actions',
      ],
      commitMessageTopic: 'GitHub Action {{depName}}',
      automerge: true,
    },
    {
      matchManagers: [
        'gomod',
      ],
      commitMessageTopic: 'Go {{depName}}',
      semanticCommitType: 'fix',
      automerge: true,
    },
    {
      matchManagers: [
        'docker-compose',
        'dockerfile',
      ],
      matchDepNames: [
        '!golang',
      ],
      commitMessageTopic: 'Docker {{depName}}',
      semanticCommitType: 'fix',
      automerge: true,
    },
  ],
}
